@using Microsoft.AspNetCore.Identity
@using SistemadeGestãodeAtivosdeTI.Models
@inject SignInManager<UsuarioModel> SignInManager
@inject UserManager<UsuarioModel> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var usuario = await UserManager.GetUserAsync(User);

        <li class="nav-item">
            <span class="nav-link text-dark">
                Olá, @(usuario?.NomeCompleto ?? User.Identity?.Name)
            </span>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="nav-link btn btn-link text-dark border-0">Sair</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Registrar">Cadastrar</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Entrar</a>
        </li>
    }
</ul>