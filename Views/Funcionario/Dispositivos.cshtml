@model SistemadeGestãodeAtivosdeTI.Models.FuncionarioModel

@{
    ViewData["Title"] = "Dispositivos";
}

<h1>Dispositivos de @Model.Nome</h1>

@if (Model.Equipamentos == null || !Model.Equipamentos.Any())
{
    <p>Este funcionário não possui dispositivos atribuídos.</p>
}
else
{
    <table class="table">

        <thead>
            <tr>
                <th>Tipo</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Número de Série</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var equipamento in Model.Equipamentos)
            {
                <tr>
                    <td>@equipamento.TipoEquipamento</td>
                    <td>@equipamento.Marca</td>
                    <td>@equipamento.Modelo</td>
                    <td>@equipamento.NumeroSerie</td>
                    <td>@equipamento.Status</td>
                </tr>
            }
        </tbody>

    </table>
}