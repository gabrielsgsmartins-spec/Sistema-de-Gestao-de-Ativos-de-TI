@model FuncionarioModel

@{
    ViewData["Title"] = "Excluir Funcionário";
}
<form asp-controller="Funcionario"
      asp-action="ExcluirConfirmacao"
      method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit">
        Confirmar exclusão
    </button>

    <a asp-controller="Funcionario"
       asp-action="Index">
        Cancelar
    </a>

</form>