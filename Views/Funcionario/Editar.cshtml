@model FuncionarioModel

@{
    ViewData["Title"] = "Editar Funcionário";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Editar Funcionário</h1>
            <p class="text-muted">Edite as informações do funcionário.</p>
        </div>

        <a class="btn btn-secondary"
           asp-controller="Funcionario"
           asp-action="Index">
            Voltar
        </a>
    </div>

    <div class="card p-4">

        <form asp-controller="Funcionario"
              asp-action="Editar"
              method="post">

            <!-- Mantém o ID do funcionário ao submeter o formulário -->
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="Nome">Nome</label>
                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Digite o nome" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Cargo">Cargo</label>
                    <input asp-for="Cargo"
                           class="form-control"
                           placeholder="Digite o cargo" />
                    <span asp-validation-for="Cargo" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Cpf">CPF</label>
                    <input asp-for="Cpf"
                           class="form-control"
                           placeholder="Digite o CPF" />
                    <span asp-validation-for="Cpf" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Departamento">Departamento</label>
                    <select asp-for="Departamento"
                            asp-items="Html.GetEnumSelectList<SistemadeGestãodeAtivosdeTI.Enums.DepartamentoEnum>()"
                            class="form-control">
                        <option value="">-- Selecione o Departamento --</option>
                    </select>
                    <span asp-validation-for="Departamento" class="text-danger"></span>
                </div>

            </div>

            <div class="d-flex gap-2 mt-4">

                <a class="btn btn-secondary"
                   asp-controller="Funcionario"
                   asp-action="Index">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary">
                    Salvar Alterações
                </button>

            </div>

        </form>

    </div>
</div>