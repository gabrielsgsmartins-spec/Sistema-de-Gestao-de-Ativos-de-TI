@model EquipamentoModel
@{
    ViewData["Title"] = "Editar Equipamento";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Editar Equipamento</h1>
            <p class="text-muted">Editar um equipamento de TI.</p>
        </div>

        <a class="btn btn-secondary"
           asp-controller="Equipamento"
           asp-action="Index">
            Voltar
        </a>
    </div>

    <div class="card p-4">

        <form asp-controller="Equipamento"
              asp-action="Editar"
              method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="TipoEquipamento">Tipo de equipamento</label>

                    <select asp-for="TipoEquipamento" class="form-control">
                        @foreach (var tipo in ViewBag.Tipos)
                        {
                            <option value="@((int)tipo)">@tipo</option>
                        }
                    </select>

                    <span asp-validation-for="TipoEquipamento" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Marca">Marca</label>

                    <input asp-for="Marca"
                           class="form-control"
                           placeholder="@Model.Marca" />

                    <span asp-validation-for="Marca" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Modelo">Modelo</label>

                    <input asp-for="Modelo"
                           class="form-control"
                           placeholder="@Model.Modelo" />

                    <span asp-validation-for="Modelo" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NumeroSerie">Número de série</label>

                    <input asp-for="NumeroSerie"
                           class="form-control"
                           placeholder="@Model.NumeroSerie" />

                    <span asp-validation-for="NumeroSerie" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DataCompra">Data de compra</label>

                    <input asp-for="DataCompra"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="DataCompra" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ValorCompra">Valor de compra</label>

                    <input asp-for="ValorCompra"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="@Model.ValorCompra.ToString("F2")" />

                    <span asp-validation-for="ValorCompra" class="text-danger"></span>
                </div>

            </div>

            <div class="d-flex gap-2 mt-4">

                <a class="btn btn-secondary"
                   asp-controller="Equipamento"
                   asp-action="Index">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary">
                    Adicionar
                </button>

            </div>

        </form>

    </div>

</div>