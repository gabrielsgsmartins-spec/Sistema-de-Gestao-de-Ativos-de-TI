@model SistemadeGestãodeAtivosdeTI.Models.EquipamentoModel

@{
    ViewData["Title"] = "Enviar para Manutenção";
}

<div class="container mt-4">
    <h2>Enviar para Manutenção</h2>
    <p class="text-muted">Equipamento: <strong>@Model.Modelo</strong> (@Model.Marca) - Série: @Model.NumeroSerie</p>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-controller="Equipamento" asp-action="EmManutencao" method="post">

                <!-- ID retornado para a Action HttpPost -->
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="form-group mb-3">
                    <label for="motivo" class="form-label fw-bold">Motivo da Manutenção</label>
                    <textarea id="motivo" name="motivo" class="form-control" rows="4" placeholder="Descreva o problema ou defeito..." required></textarea>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-warning">Confirmar e Enviar</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>